# Access Gate Service - Lab04 environment example
# Copy sang .env va thay gia tri that. KHONG commit .env chua secret that.

SERVICE_NAME=access-gate-service
SERVICE_VERSION=v0.1.0-team-gate
PORT=8000

# Bearer token de test auth (chi dung cho Lab04 local/demo)
ACCESS_GATE_API_TOKEN=dev-secret-token

# Bien DB - team-gate can khai bao rieng (de bai luu y)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=access_gate_db
DB_USER=access_gate_user
DB_PASSWORD=change-me-in-real-env
