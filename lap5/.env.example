# Access Gate Service - Lab05 environment example
# Copy sang .env va thay gia tri that. KHONG commit .env chua secret that.

SERVICE_NAME=access-gate-service
SERVICE_VERSION=v0.1.0-team-gate
APP_PORT=8000

# Bearer token de test auth
ACCESS_GATE_API_TOKEN=dev-secret-token
AUTH_TOKEN=dev-secret-token

# Bien DB (Postgres) - dung trong docker-compose, service "db"
POSTGRES_USER=access_gate_user
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=access_gate_db

# gate-worker (thay AI service, team-gate khong dung AI)
GATE_WORKER_URL=http://gate-worker:9000
